@startuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
    ArrowColor #000000
}

class "<<Interface>>\nISemantica" as ISem {
    + analise_semantica(ast: ProgramAST)
}
class "Analisador Semântico\n(C_Semantico)" as CSem {
    - tabela_simbolos: ITabelaSimbolos
    - erros_semanticos: List<String>
    + analise_semantica(ast: ProgramAST)
    + checar_tipos(no: ASTNode)
    + obter_erros(): List<String>
}
ISem <|.. CSem
@enduml
