@startuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
    ArrowColor #000000
}

class "<<Interface>>\nITabelaSimbolos" as ISym {
    + inserir(id: String, tipo: Tipo)
    + buscar(id: String): Simbolo
}
class "Tabela de Símbolos\n(C_TabelaSimbolos)" as CSym {
    - escopos: List<Escopo>
    - nivel_corrente: int
    + entrar_escopo()
    + sair_escopo()
    + inserir(id: String, tipo: Tipo)
    + buscar(id: String): Simbolo
}
ISym <|.. CSym
@enduml
