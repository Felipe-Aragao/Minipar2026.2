@startuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
    ArrowColor #000000
}

class "<<Interface>>\nIControle" as ICtrl {
    + execucao_interface()
}
class "Controle\n(C_Controle)" as CCtrl {
    - modo_execucao: String
    + execucao_interface()
    + apresentar_interface_cli()
    + apresentar_interface_web()
}
ICtrl <|.. CCtrl
@enduml
