@startuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
    ArrowColor #000000
}

class "<<Interface>>\nISintatica" as ISyn {
    + analise_sintatica(): ProgramAST
}
class "Analisador Sintático\n(C_Sintatico)" as CSyn {
    - tokens: List<Token>
    - pos_token: int
    - ast: ProgramAST
    + analise_sintatica(): ProgramAST
    + obter_ast(): ProgramAST
    + consumir(tipo_esperado)
}
ISyn <|.. CSyn
@enduml
