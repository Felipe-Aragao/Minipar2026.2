@startuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
    ArrowColor #000000
}

class "<<Interface>>\nITAC" as ITac {
    + gerar_tac(ast: ProgramAST): List<InstrucaoTAC>
}
class "Gerador TAC\n(C_TAC)" as CTac {
    - temporarios: int
    - rotulos: int
    - instrucoes: List<InstrucaoTAC>
    + novo_temp(): String
    + novo_label(): String
    + gerar_tac(ast: ProgramAST): List<InstrucaoTAC>
}
ITac <|.. CTac
@enduml
