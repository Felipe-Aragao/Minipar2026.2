# Teste 11: MiniCompilador de Expressoes Infixadas em MiniPar 2026.2
# Implementacao fiel ao MiniCompiladorCompleto_ARMv7.java da disciplina.
# Gera Tokens, AST hierarquica, TAC, Assembly ARMv7 compativel com CPUlator,
# Tabela de Simbolos e Avaliacao Numerica da expressao.

class Tokenizador {
    var tipos = [""];
    var lexemas = [""];

    func digito(c) {
        return c >= "0" && c <= "9";
    }

    func letra(c) {
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_";
    }

    func analisar(entrada) {
        this.tipos = [""];
        this.tipos.pop();
        this.lexemas = [""];
        this.lexemas.pop();

        var i = 0;
        var n = len(entrada);
        while (i < n) {
            var c = entrada[i];
            if (c == " " || c == "\t" || c == "\r" || c == "\n") {
                i = i + 1;
            } else if (c == "#") {
                while (i < n && entrada[i] != "\n") {
                    i = i + 1;
                }
            } else if (this.digito(c)) {
                var num = c;
                i = i + 1;
                while (i < n && this.digito(entrada[i])) {
                    num = num + entrada[i];
                    i = i + 1;
                }
                if (i < n && entrada[i] == ".") {
                    num = num + ".";
                    i = i + 1;
                    while (i < n && this.digito(entrada[i])) {
                        num = num + entrada[i];
                        i = i + 1;
                    }
                }
                this.tipos.append("NUMERO");
                this.lexemas.append(num);
            } else if (this.letra(c)) {
                var id = c;
                i = i + 1;
                while (i < n && (this.letra(entrada[i]) || this.digito(entrada[i]))) {
                    id = id + entrada[i];
                    i = i + 1;
                }
                this.tipos.append("IDENTIFICADOR");
                this.lexemas.append(id);
            } else if (c == "+" || c == "-" || c == "*" || c == "/") {
                this.tipos.append("OPERADOR");
                this.lexemas.append(c);
                i = i + 1;
            } else if (c == "(" || c == ")") {
                this.tipos.append("PARENTESE");
                this.lexemas.append(c);
                i = i + 1;
            } else if (c == "=") {
                this.tipos.append("ATRIBUICAO");
                this.lexemas.append(c);
                i = i + 1;
            } else {
                i = i + 1;
            }
        }
    }
}

class MiniCompilador {
    var tipos = [""];
    var lexemas = [""];
    var pos = 0;
    var raiz = -1;

    var nos_valor = [""];
    var nos_esq = [0];
    var nos_dir = [0];

    var sim_nomes = [""];
    var sim_tipos = [""];

    var tempCount = 1;
    var regCount = 0;
    var assemblyARM = "";

    func carregarTokens(t, l) {
        this.tipos = t;
        this.lexemas = l;
        this.pos = 0;
        this.raiz = -1;
        this.nos_valor = [""];
        this.nos_valor.pop();
        this.nos_esq = [0];
        this.nos_esq.pop();
        this.nos_dir = [0];
        this.nos_dir.pop();
        this.sim_nomes = [""];
        this.sim_nomes.pop();
        this.sim_tipos = [""];
        this.sim_tipos.pop();
        this.tempCount = 1;
        this.regCount = 0;
        this.assemblyARM = "";
    }

    func isOperador(s) {
        return s == "+" || s == "-" || s == "*" || s == "/";
    }

    func isDigito(c) {
        return c >= "0" && c <= "9";
    }

    func isNumero(s) {
        if (len(s) == 0) { return false; }
        var i = 0;
        var pontos = 0;
        while (i < len(s)) {
            var c = s[i];
            if (c == ".") {
                pontos = pontos + 1;
                if (pontos > 1) { return false; }
            } else if (!this.isDigito(c)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    func registrarSimbolo(token) {
        if (this.isOperador(token)) { return; }
        var i = 0;
        while (i < len(this.sim_nomes)) {
            if (this.sim_nomes[i] == token) { return; }
            i = i + 1;
        }
        this.sim_nomes.append(token);
        if (this.isNumero(token)) {
            this.sim_tipos.append("CONST");
        } else {
            this.sim_tipos.append("VAR");
        }
    }

    func ordenarSimbolos() {
        var i = 0;
        while (i < len(this.sim_nomes)) {
            var j = i + 1;
            while (j < len(this.sim_nomes)) {
                if (this.sim_nomes[j] < this.sim_nomes[i]) {
                    var tmpN = this.sim_nomes[i];
                    this.sim_nomes[i] = this.sim_nomes[j];
                    this.sim_nomes[j] = tmpN;
                    var tmpT = this.sim_tipos[i];
                    this.sim_tipos[i] = this.sim_tipos[j];
                    this.sim_tipos[j] = tmpT;
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    func criar_no(valor, esq, dir) {
        var idx = len(this.nos_valor);
        this.nos_valor.append(valor);
        this.nos_esq.append(esq);
        this.nos_dir.append(dir);
        return idx;
    }

    func parseFactor() {
        var token = this.lexemas[this.pos];
        this.pos = this.pos + 1;
        if (token == "(") {
            this.parseExpr();
            if (this.pos < len(this.lexemas) && this.lexemas[this.pos] == ")") {
                this.pos = this.pos + 1;
            }
        } else {
            this.registrarSimbolo(token);
            this.raiz = this.criar_no(token, -1, -1);
        }
    }

    func parseTerm() {
        this.parseFactor();
        while (this.pos < len(this.lexemas) && (this.lexemas[this.pos] == "*" || this.lexemas[this.pos] == "/")) {
            var op = this.lexemas[this.pos];
            this.pos = this.pos + 1;
            var esq = this.raiz;
            this.parseFactor();
            var dir = this.raiz;
            this.raiz = this.criar_no(op, esq, dir);
        }
    }

    func parseExpr() {
        this.parseTerm();
        while (this.pos < len(this.lexemas) && (this.lexemas[this.pos] == "+" || this.lexemas[this.pos] == "-")) {
            var op = this.lexemas[this.pos];
            this.pos = this.pos + 1;
            var esq = this.raiz;
            this.parseTerm();
            var dir = this.raiz;
            this.raiz = this.criar_no(op, esq, dir);
        }
    }

    func imprimirAST(idx, nivel) {
        if (idx < 0) { return; }
        var d = to_int(this.nos_dir[idx]);
        var e = to_int(this.nos_esq[idx]);
        this.imprimirAST(d, nivel + 1);
        var espaco = "";
        var k = 0;
        while (k < nivel) {
            espaco = espaco + "  ";
            k = k + 1;
        }
        print(espaco + this.nos_valor[idx]);
        this.imprimirAST(e, nivel + 1);
    }

    func gerarTAC(idx) {
        if (idx < 0) { return ""; }
        var val = this.nos_valor[idx];
        if (!this.isOperador(val)) {
            return val;
        }
        var e = to_int(this.nos_esq[idx]);
        var d = to_int(this.nos_dir[idx]);
        var a1 = this.gerarTAC(e);
        var a2 = this.gerarTAC(d);
        var temp = "t" + to_string(this.tempCount);
        this.tempCount = this.tempCount + 1;
        print(temp + " = " + a1 + " " + val + " " + a2);
        return temp;
    }

    func formatExpr(idx) {
        if (idx < 0) { return ""; }
        var val = this.nos_valor[idx];
        if (!this.isOperador(val)) {
            return val;
        }
        var e = to_int(this.nos_esq[idx]);
        var d = to_int(this.nos_dir[idx]);
        return "(" + this.formatExpr(e) + " " + val + " " + this.formatExpr(d) + ")";
    }

    func gerarAssemblyARM(idx) {
        if (idx < 0) { return ""; }
        var val = this.nos_valor[idx];
        if (!this.isOperador(val)) {
            var reg = "r" + to_string(this.regCount);
            this.regCount = this.regCount + 1;
            var linha = "    MOV    " + reg + ", #" + val;
            print(linha);
            this.assemblyARM = this.assemblyARM + linha + "\n";
            return reg;
        }

        var e = to_int(this.nos_esq[idx]);
        var d = to_int(this.nos_dir[idx]);
        var a1 = this.gerarAssemblyARM(e);
        var a2 = this.gerarAssemblyARM(d);
        var reg = "r" + to_string(this.regCount);
        this.regCount = this.regCount + 1;

        var instr = "NOP";
        if (val == "+") { instr = "ADD"; }
        if (val == "-") { instr = "SUB"; }
        if (val == "*") { instr = "MUL"; }
        if (val == "/") { instr = "DIV_UNSUPPORTED"; }

        var exprFmt = this.formatExpr(idx);
        var linha = "";
        if (instr == "DIV_UNSUPPORTED") {
            linha = "    @ divisão não suportada: " + a1 + " / " + a2 + "    @ resultado de '" + exprFmt + "'";
        } else {
            var opPad = instr;
            if (len(opPad) < 6) {
                var diff = 6 - len(opPad);
                var p = 0;
                while (p < diff) {
                    opPad = opPad + " ";
                    p = p + 1;
                }
            }
            linha = "    " + opPad + " " + reg + ", " + a1 + ", " + a2 + "    @ resultado de '" + exprFmt + "'";
        }
        print(linha);
        this.assemblyARM = this.assemblyARM + linha + "\n";
        return reg;
    }

    func avaliarExpressao(idx) {
        if (idx < 0) { return 0.0; }
        var val = this.nos_valor[idx];
        if (!this.isOperador(val)) {
            if (this.isNumero(val)) {
                return to_number(val);
            }
            print("Aviso: Variavel '" + val + "' nao tem valor atribuido. Usando 0.");
            return 0.0;
        }
        var e = to_int(this.nos_esq[idx]);
        var d = to_int(this.nos_dir[idx]);
        var esq = this.avaliarExpressao(e);
        var dir = this.avaliarExpressao(d);
        if (val == "+") { return esq + dir; }
        if (val == "-") { return esq - dir; }
        if (val == "*") { return esq * dir; }
        if (val == "/") {
            if (dir != 0) { return esq / dir; }
            return 0.0;
        }
        return 0.0;
    }
}

seq {
    var entrada = input("Digite uma expressão infixada: ");
    if (len(entrada) == 0) {
        entrada = "((2+4)*7)-(5*4)";
    }

    var lexer = new Tokenizador();
    lexer.analisar(entrada);

    print("");
    print("Tokens gerados pelo analisador lexico:");
    var k = 0;
    while (k < len(lexer.tipos)) {
        print("[" + lexer.tipos[k] + ": '" + lexer.lexemas[k] + "']");
        k = k + 1;
    }

    var comp = new MiniCompilador();
    comp.carregarTokens(lexer.tipos, lexer.lexemas);
    comp.parseExpr();
    var raiz = comp.raiz;

    print("");
    print("Arvore Sintatica Abstrata (AST):");
    comp.imprimirAST(raiz, 0);

    print("");
    print("Codigo de Tres Enderecos (TAC):");
    comp.gerarTAC(raiz);

    print("");
    print("Assembly ARMv7 (CPUlator):");
    var cabecalho = ".global _start\n.text\n_start:\n";
    print(".global _start");
    print(".text");
    print("_start:");
    comp.assemblyARM = cabecalho;
    comp.gerarAssemblyARM(raiz);
    var rodape = "    b .    @ loop infinito para parar o programa\n";
    print("    b .    @ loop infinito para parar o programa");
    comp.assemblyARM = comp.assemblyARM + rodape;

    print("");
    print("Tabela de Simbolos:");
    comp.ordenarSimbolos();
    var s = 0;
    while (s < len(comp.sim_nomes)) {
        print(comp.sim_nomes[s] + " -> " + comp.sim_tipos[s]);
        s = s + 1;
    }

    print("");
    print("Resultado final da expressao:");
    var res = comp.avaliarExpressao(raiz);
    print("-> " + fmt(res, 1));

    # Salva o arquivo .arm compativel com CPUlator
    write_file("output/teste11.arm", comp.assemblyARM);
}
