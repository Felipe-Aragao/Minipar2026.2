# PC B calcula Fibonacci e devolve a sequência ao PC A.
seq {
    var ip_a = input("IP do PC A: ");
    var limite = to_int(receive(c_channel("0.0.0.0", 15201)));
    var a = 0;
    var b = 1;
    var i = 0;
    var texto = "";
    while (i < limite) {
        if (i > 0) { texto = texto + " "; }
        texto = texto + to_string(a);
        var proximo = a + b;
        a = b;
        b = proximo;
        i = i + 1;
    }
    print("PC B - Fibonacci:", texto);
    send(c_channel(ip_a, 15202), texto);
}
