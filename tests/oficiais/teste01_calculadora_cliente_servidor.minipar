# Teste 1: Calculadora cliente-servidor com sockets
# O cliente envia operacao e operandos por canal TCP; o servidor calcula e responde.

func calcular(op, v1, v2) {
    if (op == "+") { return v1 + v2; }
    if (op == "-") { return v1 - v2; }
    if (op == "*") { return v1 * v2; }
    if (op == "/") {
        if (v2 == 0) {
            print("Erro: divisao por zero");
            return 0;
        }
        return v1 / v2;
    }
    return 0;
}

seq {
    print("==== Calculadora cliente-servidor ====");
    print("Opcoes: +, -, *, /");
    # Cada receive abre e fecha um listener. Uma porta por campo evita
    # que o proximo envio entre na fila do listener que vai ser fechado.
    var canal_operacao = c_channel("127.0.0.1", 5101);
    var resposta = c_channel("127.0.0.1", 5102);
    var canal_v1 = c_channel("127.0.0.1", 5103);
    var canal_v2 = c_channel("127.0.0.1", 5104);

    par {
        # Thread servidor: recebe operação e operandos, devolve resultado
        seq {
            var op = receive(canal_operacao);
            var s_v1 = receive(canal_v1);
            var s_v2 = receive(canal_v2);
            var v1 = to_number(s_v1);
            var v2 = to_number(s_v2);
            print("Servidor recebeu:", op, s_v1, s_v2);
            var res = calcular(op, v1, v2);
            send(resposta, to_string(res));
        }
        # Thread cliente: lê dados do terminal e envia ao servidor
        seq {
            var operacao = input("Operacao (+,-,*,/): ");
            var operando1 = input("Operando 1: ");
            var operando2 = input("Operando 2: ");
            send(canal_operacao, operacao);
            send(canal_v1, operando1);
            send(canal_v2, operando2);
            var resultado = receive(resposta);
            print("Resultado:", resultado);
        }
    }
}
